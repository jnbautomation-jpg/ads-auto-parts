# Copy to .env and fill in real values. NEVER commit the filled-in .env.
#
# Local development must point at the DEV Supabase project, never production.

# --- Database -------------------------------------------------------------
# Two URLs, and they are NOT interchangeable.
#
# DATABASE_URL: Supabase TRANSACTION pooler. Port 6543, with pgbouncer=true.
# Every runtime query goes through this (src/lib/prisma.ts).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: Supabase SESSION pooler. Port 5432, no pgbouncer flag.
# Used only by Prisma Migrate (prisma.config.ts), which needs a non-pooled
# connection for advisory locks and DDL.
#
# Do NOT set this to db.<project-ref>.supabase.co — that host is IPv6-only
# and unreachable on the shop's network.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Supabase auth --------------------------------------------------------
# Safe to expose to the browser (NEXT_PUBLIC_*).
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="<publishable-key>"

# Server-only. Bypasses row-level security and can modify ANY auth user.
# Never expose to the browser, never inline into a client component.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# --- AI chat assistant (optional) ------------------------------------------
# Anthropic API key for the parts assistant (the bubble in the bottom-right).
# Create one at https://console.anthropic.com/ -> API Keys.
#
# WITHOUT this key the site works normally and the chat bubble simply does not
# appear — nothing breaks, so it is safe to deploy before setting it.
#
# Cost scales with traffic; src/lib/chat.ts caps message length, history
# length, and messages per visitor per hour. Set a spend limit in the
# Anthropic console as well.
ANTHROPIC_API_KEY="sk-ant-..."
