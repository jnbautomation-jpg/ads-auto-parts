# Copy to .env and fill in real values. NEVER commit the filled-in .env.
#
# Local development must point at the DEV Supabase project, never production.

# --- Database -------------------------------------------------------------
# Two URLs, and they are NOT interchangeable.
#
# DATABASE_URL: Supabase TRANSACTION pooler. Port 6543, with pgbouncer=true.
# Every runtime query goes through this (src/lib/prisma.ts).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: Supabase SESSION pooler. Port 5432, no pgbouncer flag.
# Used only by Prisma Migrate (prisma.config.ts), which needs a non-pooled
# connection for advisory locks and DDL.
#
# Do NOT set this to db.<project-ref>.supabase.co — that host is IPv6-only
# and unreachable on the shop's network.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Supabase auth --------------------------------------------------------
# Safe to expose to the browser (NEXT_PUBLIC_*).
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="<publishable-key>"

# Server-only. Bypasses row-level security and can modify ANY auth user.
# Never expose to the browser, never inline into a client component.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# --- AI chat assistant (optional) ------------------------------------------
# Anthropic API key for the parts assistant (the bubble in the bottom-right).
# Create one at https://console.anthropic.com/ -> API Keys.
#
# WITHOUT this key the site works normally and the chat bubble simply does not
# appear — nothing breaks, so it is safe to deploy before setting it.
#
# Cost scales with traffic; src/lib/chat.ts caps message length, history
# length, and messages per visitor per hour. Set a spend limit in the
# Anthropic console as well.
ANTHROPIC_API_KEY="sk-ant-..."

# --- Lead notification email ----------------------------------------------
# WITHOUT these the site still works and leads are still saved — they are just
# invisible until someone opens /inquiries, which is the exact problem this
# feature exists to fix. An unset key is logged on every lead rather than
# passed over silently.
#
# RESEND_API_KEY is injected automatically by the Vercel Resend integration
# (`vercel integration add resend`). Set it by hand for local development:
# https://resend.com/api-keys
RESEND_API_KEY="re_..."

# Envelope sender. MUST be an address on a domain verified in Resend.
#
# Left unset it falls back to Resend's shared onboarding sender, which only
# delivers to the address that owns the API key — fine for proving the wiring
# works, useless for real lead mail. Verify autodoorstoreorlando.com in Resend
# (three DNS records) and then set this.
EMAIL_FROM="ADS Auto Parts <leads@autodoorstoreorlando.com>"

# Who gets told about a new quote request or a new paid order.
# Comma-separated; whitespace is trimmed.
#
# LEAVE IT UNSET unless you are adding someone. It defaults to EMAIL in
# src/lib/site.ts — the shop's own published address — so it is already
# correct, and site.ts is deliberately the only place that address is written
# down. Setting it here to the same value pins it in a second place, which is
# the drift site.ts exists to prevent. Set it to ADD a recipient:
#
#     SHOP_EMAIL_TO="autodoorstorewest@gmail.com,marketing@example.com"

# --- Stripe checkout -------------------------------------------------------
# WITHOUT these the site works normally and the checkout page shows "online
# payment isn't switched on yet" with the shop's phone number — no dead end.
# Everything else (cart, catalog, quotes) is unaffected.
#
# Install via the Vercel Marketplace — `vercel integration add stripe` — which
# sets these on the project. https://dashboard.stripe.com/apikeys for local.

# Server only. NEVER expose to the browser, never commit, never log.
STRIPE_SECRET_KEY="sk_test_..."

# Safe in the page source by design — it identifies the account, it does not
# authorise anything.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Signs the webhook at /api/stripe/webhook, which is the SOURCE OF TRUTH for
# whether an order was paid. Without it the route returns 503 and every order
# stays UNPAID — Stripe retries, so setting it later still delivers the
# backlog, but nothing is marked paid until it is set.
#
# Get it from the Stripe dashboard (Developers > Webhooks > your endpoint), or
# from `stripe listen --forward-to localhost:3000/api/stripe/webhook` locally.
STRIPE_WEBHOOK_SECRET="whsec_..."
