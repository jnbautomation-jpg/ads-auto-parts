// Prisma schema for ADS Auto Parts (Orlando) — inventory + public catalog.
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Multi-tenancy
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  products      Product[]
  vehicleFits   VehicleFit[]
  suppliers     Supplier[]
  stockMovements StockMovement[]
  inquiries     Inquiry[]
  customers     CustomerAccount[]
  orders        Order[]
  chatSessions  ChatSession[]

  @@map("organizations")
}

enum UserRole {
  OWNER
  ADMIN
  STAFF
}

// Mirrors a Supabase Auth user (auth.users.id) with app-level role/org data.
model User {
  id             String   @id // Supabase Auth user id (uuid)
  organizationId String
  email          String
  role           UserRole @default(STAFF)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stockMovements    StockMovement[]
  reviewedCustomers CustomerAccount[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Customer accounts (Phase 2A — spec step 5)
// ---------------------------------------------------------------------------

// What a signed-in customer pays.
enum CustomerTier {
  RETAIL
  WHOLESALE
}

// A wholesale application is approved by a human, never automatically — the
// spec is explicit that self-signup would let competitors read trade pricing.
enum WholesaleStatus {
  PENDING
  APPROVED
  REJECTED
}

// A shop or retail buyer. DELIBERATELY a separate table from User rather than
// extra values on UserRole:
//
//   * User rows grant staff access — getAuthContext() looks a Supabase auth id
//     up in `users`, and every admin page and server action is gated on the
//     result. A customer must never appear there, so no bug in customer
//     signup can ever mint a staff account.
//   * Staff and customers carry genuinely different data (a shop has a
//     company name and a wholesale application; staff have an org role).
//
// One person could in principle hold both a staff User and a CustomerAccount;
// they are keyed independently by Supabase auth id and never merged.
model CustomerAccount {
  id             String @id @default(cuid())
  organizationId String

  // Supabase Auth user id (uuid). Unique globally, not just per org — one
  // auth identity is exactly one customer account.
  authUserId String @unique

  email String
  name  String?
  phone String?

  // Wholesale applicants only.
  companyName String?

  tier CustomerTier @default(RETAIL)

  // null = never applied. PENDING blocks wholesale pricing until a staff
  // member approves; tier is what actually resolves pricing, and only an
  // approval sets it to WHOLESALE.
  wholesaleStatus WholesaleStatus?
  // Free-text reason shown to the applicant when rejected.
  wholesaleNote   String?
  appliedAt       DateTime?
  reviewedAt      DateTime?
  // Staff User.id who approved or rejected. SetNull so removing a staff
  // member never deletes the customer's application history.
  reviewedById    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reviewedBy    User?          @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  savedVehicles SavedVehicle[]
  orders        Order[]

  @@unique([organizationId, email])
  @@index([organizationId, tier])
  // Staff review queue: pending applications, oldest first.
  @@index([organizationId, wholesaleStatus])
  @@map("customer_accounts")
}

// "Saved vehicles" on the account dashboard — a shop that works on the same
// cars repeatedly shouldn't retype the fit every visit.
model SavedVehicle {
  id                String @id @default(cuid())
  customerAccountId String

  make  String
  model String
  year  Int

  label String?

  createdAt DateTime @default(now())

  customerAccount CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)

  // The same vehicle saved twice is a mistake, not a feature.
  @@unique([customerAccountId, make, model, year])
  @@index([customerAccountId])
  @@map("saved_vehicles")
}

// ---------------------------------------------------------------------------
// AI chat (Phase 2B)
// ---------------------------------------------------------------------------

enum ChatRole {
  USER
  ASSISTANT
}

// One browser's conversation. Keyed by an anonymous cookie, not by identity —
// a customer can ask about parts without an account.
//
// Logged for two reasons: it is what the rate limiter counts (serverless
// instances share no memory, so the limit has to live in the database), and
// the transcript tells the shop what customers ask for that isn't in stock.
model ChatSession {
  id             String @id @default(cuid())
  organizationId String

  // Random opaque value from an httpOnly cookie. No PII.
  sessionKey String @unique

  locale String @default("en")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages     ChatMessage[]

  @@index([organizationId, createdAt])
  @@map("chat_sessions")
}

model ChatMessage {
  id            String @id @default(cuid())
  chatSessionId String

  role    ChatRole
  content String

  createdAt DateTime @default(now())

  chatSession ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)

  // Rate limiting counts recent rows, so this index carries that query.
  @@index([chatSessionId, createdAt])
  @@map("chat_messages")
}

// ---------------------------------------------------------------------------
// Orders (Phase 2A — spec steps 7 & 8)
// ---------------------------------------------------------------------------

// Warehouse-facing lifecycle, matching the statuses the spec names.
enum OrderStatus {
  NEW
  READY
  DELIVERED
  PICKED_UP
  CANCELLED
}

enum FulfillmentMethod {
  DELIVERY
  PICKUP
}

// Payment is tracked separately from fulfilment: a part can be paid for and
// not yet collected, or (for "reserve now, pay at pickup") collected and paid
// at the counter.
enum PaymentStatus {
  UNPAID
  DEPOSIT_PAID
  PAID
  REFUNDED
}

model Order {
  id             String @id @default(cuid())
  organizationId String

  // Human-readable reference staff quote on the phone. Allocated from a
  // Postgres sequence so two simultaneous checkouts can't collide.
  orderNumber Int

  // Null for a guest checkout — an order must not require an account.
  customerAccountId String?

  // Contact details are SNAPSHOT here rather than read through the account.
  // A customer changing their phone number later must not rewrite the
  // details the warehouse used to fulfil an order already shipped.
  customerName  String
  customerEmail String?
  customerPhone String

  status      OrderStatus       @default(NEW)
  fulfillment FulfillmentMethod @default(PICKUP)
  // Only for DELIVERY orders.
  deliveryAddress String?

  paymentStatus PaymentStatus @default(UNPAID)

  // Stripe's payment intent. The spec is explicit that webhooks — not the
  // client callback — are the source of truth for payment success, so this
  // is what a webhook matches an order on. Unique so a replayed webhook
  // can't create a second order.
  stripePaymentIntentId String? @unique

  // Which price tier the buyer was on when they ordered. Kept for the audit
  // trail: it explains why a line item cost what it did.
  pricedAsTier CustomerTier @default(RETAIL)

  subtotal Decimal @db.Decimal(10, 2)
  total    Decimal @db.Decimal(10, 2)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerAccount CustomerAccount? @relation(fields: [customerAccountId], references: [id], onDelete: SetNull)
  items           OrderItem[]

  @@unique([organizationId, orderNumber])
  // Staff dashboard: filter by status, newest first.
  @@index([organizationId, status, createdAt])
  @@index([organizationId, createdAt])
  @@index([customerAccountId])
  @@map("orders")
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String

  // SetNull, not Cascade: deleting a product must never erase the record of
  // having sold it.
  productId String?

  // Snapshot of what was sold, at the price it sold for. Repricing a part or
  // renaming a model later must not rewrite history — and for a deleted
  // product this is the only remaining description.
  sku         String
  description String
  unitPrice   Decimal @db.Decimal(10, 2)
  quantity    Int
  lineTotal   Decimal @db.Decimal(10, 2)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

// Extensible on purpose: add new body-part categories here as the catalog grows.
enum PartType {
  DOOR
  HOOD
  TAILGATE
  TRUNK
  LIFTGATE
  REAR_BODY_PANEL
  QUARTER_PANEL
  FENDER
  BUMPER
  GRILLE
  HINGE
  RADIATOR_SUPPORT
  REINFORCEMENT_BAR
}

enum PartPosition {
  FRONT_LEFT
  FRONT_RIGHT
  REAR_LEFT
  REAR_RIGHT
  FRONT
  REAR
}

enum PartCondition {
  A
  B
  C
}

model Supplier {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  contact        String?
  phone          String?
  email          String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  products     Product[]

  @@index([organizationId])
  @@map("suppliers")
}

model Product {
  id             String   @id @default(cuid())
  organizationId String

  // Auto-generated, unique per org (e.g. ACC-18-DR-L). Never a manufacturer part number —
  // this dealer's parts aren't identified by one. Fit + part type is the real identity.
  sku String

  partType PartType

  // Vehicle fit — a part is frequently valid across a run of model years, not just one.
  make      String
  model     String
  yearStart Int
  yearEnd   Int

  position PartPosition?

  color     String?
  paintCode String?

  // Warehouse bin code (e.g. "H16", "A23") — where staff physically find the part.
  binLocation String?

  condition      PartCondition
  conditionNotes String?

  // New aftermarket parts built to certified fit & finish standards — never
  // used salvage. Shown as a badge in the admin UI and public catalog.
  capaCertified Boolean @default(false)

  quantity      Int @default(0)
  reorderPoint  Int @default(2)

  // What ADS paid the supplier. Staff-only, never leaves the admin screens.
  cost Decimal @db.Decimal(10, 2)

  // WHOLESALE price — what a trade account pays. Staff-only for now; when
  // wholesale customer accounts land (Phase 2A) this is what those accounts
  // see. Must never be selected by a public query. See src/lib/pricing.ts.
  price Decimal @db.Decimal(10, 2)

  // RETAIL price — the only price the public catalog ever shows.
  // Backfilled to price + RETAIL_MARKUP_USD; see
  // scripts/backfill-retail-price.ts.
  retailPrice Decimal @db.Decimal(10, 2)

  photos String[]

  isPublic Boolean @default(false)

  supplierId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier       Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  vehicleFits    VehicleFit[]
  stockMovements StockMovement[]
  inquiries      Inquiry[]
  orderItems     OrderItem[]

  @@unique([organizationId, sku])
  // Public catalog / staff filtering by vehicle fit. Still used for the
  // primary fit above — full multi-vehicle search goes through VehicleFit.
  @@index([organizationId, make, model, yearStart, yearEnd])
  // Filtering by part type.
  @@index([organizationId, partType])
  // Low-stock lookups ("at or below reorder point"): fetch by org, then compare
  // quantity <= reorderPoint in the query — this index makes that scan cheap.
  @@index([organizationId, quantity])
  @@index([supplierId])
  @@map("products")
}

// Every product has at least one VehicleFit (kept in sync with the primary
// make/model/yearStart/yearEnd/position above by the single-fit admin form).
// Parts that fit more than one vehicle — a shared bumper cover, e.g. — get a
// second row here instead of a second Product. Search matches across all of
// a product's fits, not just its primary one.
model VehicleFit {
  id             String @id @default(cuid())
  organizationId String
  productId      String

  make      String
  model     String
  yearStart Int
  yearEnd   Int

  position PartPosition?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Vehicle-fit search (admin + public catalog).
  @@index([organizationId, make, model, yearStart, yearEnd])
  @@index([productId])
  @@map("vehicle_fits")
}

// ---------------------------------------------------------------------------
// Inventory audit trail
// ---------------------------------------------------------------------------

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
}

model StockMovement {
  id                String            @id @default(cuid())
  organizationId    String
  productId         String
  type              StockMovementType
  quantityChange    Int
  resultingQuantity Int
  userId            String?
  note              String?
  createdAt         DateTime          @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([productId])
  @@map("stock_movements")
}

// ---------------------------------------------------------------------------
// Public catalog leads
// ---------------------------------------------------------------------------

enum InquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

model Inquiry {
  id             String        @id @default(cuid())
  organizationId String
  productId      String?
  name           String
  phone          String?
  email          String?
  message        String?
  status         InquiryStatus @default(NEW)
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([productId])
  @@map("inquiries")
}
